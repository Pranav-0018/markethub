# Application Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/multivendor

# JWT Secret for signing authentication tokens
JWT_SECRET=supersecretkey_for_multivendor_jwt_auth_123

# Cloudinary Credentials (Optional: if empty, file upload saves to local /uploads folder or you can use image URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
